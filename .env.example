APP_NAME=CodeForge
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development

API_V1_PREFIX=/api/v1

ACCESS_TOKEN_SECRET_KEY=your_access_secret
REFRESH_TOKEN_SECRET_KEY=your_refresh_secret
EMAIL_TOKEN_SECRET_KEY=your_email_secret
RESET_TOKEN_SECRET_KEY=your_reset_secret
CRON_SECRET=your_cron_secret
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

RATE_LIMIT=100
WINDOW_SECONDS=60

OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_STARTER_PRODUCT_ID=your_polar_starter_product_id
POLAR_PLUS_PRODUCT_ID=your_polar_plus_product_id
POLAR_ULTRA_PRODUCT_ID=your_polar_ultra_product_id
POLAR_BETA_PRODUCT_ID=your_polar_beta_product_id

DATABASE_URL=postgresql+asyncpg://user:password@localhost/codeforge

EMAIL_FROM=noreply@codeforgeapp.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@codeforgeapp.com

FRONTEND_URL=http://localhost:3000